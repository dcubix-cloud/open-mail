---
// The app's rail for the feature stories: the mailbox switcher (Sana's own and the shared Support)
// and the folders. scripts/stories.ts moves "current" and "active" as a story plays.
interface Props {
  box?: "sana" | "support";
  active?: string;
}
const { box = "sana", active = "inbox" } = Astro.props;
const folders = [
  { id: "inbox", icon: "inbox" },
  { id: "starred", icon: "star" },
  { id: "sent", icon: "send" },
  { id: "drafts", icon: "file-text" },
  { id: "archive", icon: "archive" },
  { id: "bin", icon: "trash-2" },
];
---

<nav class="rail">
  <span class="rail-compose" data-el="compose-btn"><svg class="icon i20"><use href="#i-square-pen"></use></svg></span>
  <div class="rail-group rail-boxes">
    <span class={`rail-item rail-box ${box === "sana" ? "current" : ""}`} data-box="sana"><span class="avatar s28 h-30">S</span><span class="rail-box-name">Sana</span></span>
    <span class={`rail-item rail-box ${box === "support" ? "current" : ""}`} data-box="support"><span class="avatar s28 sq h-228">S</span><span class="rail-box-name">Support</span><span class="rail-dot"></span></span>
  </div>
  <div class="rail-group">
    {
      folders.map((f) => (
        <span class={`rail-item ${active === f.id ? "active" : ""}`} data-folder={f.id}>
          <svg class="icon i20 thin">
            <use href={`#i-${f.icon}`} />
          </svg>
        </span>
      ))
    }
  </div>
  <div class="rail-group bottom">
    <span class={`rail-item ${active === "settings" ? "active" : ""}`}><svg class="icon i20 thin"><use href="#i-settings"></use></svg></span>
    <span class="rail-item"><svg class="icon i20 thin"><use href="#i-moon"></use></svg></span>
    <span class="rail-item"><svg class="icon i20 thin"><use href="#i-log-out"></use></svg></span>
    <span class="rail-user"><span class="avatar s32 h-30">S</span></span>
  </div>
</nav>
